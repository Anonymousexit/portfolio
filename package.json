{
  "name": "personal-canvas-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A personal portfolio with modular content, styles, and interactions.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "playwright test",
    "format": "prettier --write src scripts tests docs *.json *.md *.js",
    "format:check": "prettier --check src scripts tests docs *.json *.md *.js",
    "pretest": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "prettier": "3.9.10"
  }
}
